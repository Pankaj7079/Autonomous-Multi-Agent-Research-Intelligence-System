# Copy into Streamlit Community Cloud → app → Settings → Secrets.
# Keys MUST stay at the root level: Streamlit only promotes root-level entries to
# environment variables, and that is how pydantic-settings reads them. Anything under
# a [section] is invisible to Settings and the app starts with no provider configured.

DEPLOYMENT_MODE = "cloud"

GROQ_API_KEY = "your_key_here"
GEMINI_API_KEY = "your_key_here"

# optional — the app degrades without them
TAVILY_API_KEY = ""
QDRANT_URL = ""
QDRANT_API_KEY = ""
