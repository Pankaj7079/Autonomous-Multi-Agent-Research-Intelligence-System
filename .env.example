# Copy to .env and fill in. Every provider below has a free tier with no card.
#   cp .env.example .env      (PowerShell: Copy-Item .env.example .env)

# ── Deployment ────────────────────────────────────────────
# "local" = docker redis + qdrant + fastapi
# "cloud" = streamlit community cloud, in-process, no docker
DEPLOYMENT_MODE=local

# which provider leads the chain. groq is ~10x faster than glm, so it leads by default;
# set to glm when groq's rate window is the bottleneck and you can accept slower runs
PRIMARY_PROVIDER=groq

# who scores the run. must be fast AND hold quota the pipeline did not just spend —
# gemini bills per day and evaluation is only a few calls. set to groq if gemini's
# daily quota is gone; the layers report "not scored" rather than a fake 0.00 either way.
EVAL_PROVIDER=gemini

# ── LLMs (all free, no card) ──────────────────────────────
# console.groq.com → API Keys
GROQ_API_KEY=gsk_your_key_here
# aistudio.google.com → Get API key
GEMINI_API_KEY=AIza_your_key_here
# console.anthropic.com → optional last-resort fallback, NOT free tier — leave blank to skip
# third free provider — glm-4.5-flash is free at z.ai, openai-compatible
GLM_API_KEY=your_key_here

ANTHROPIC_API_KEY=

# ── Search ────────────────────────────────────────────────
# tavily.com → 1000 free/month. leave blank to use DuckDuckGo only
TAVILY_API_KEY=

# ── Observability ─────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=./logs
# set false to silence the JSONL sinks (console logging stays on)
LOG_JSON_ENABLED=true
# optional prompt-level tracing, pick either
LANGSMITH_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# ── Local services (docker-compose provides these) ────────
# the streamlit frontend calls this in local mode
API_BASE_URL=http://localhost:8000

REDIS_URL=redis://localhost:6379
QDRANT_HOST=localhost
QDRANT_PORT=6333
# for cloud mode: cloud.qdrant.io free tier 1GB
QDRANT_URL=
QDRANT_API_KEY=

# ── LangGraph ─────────────────────────────────────────────
SQLITE_CHECKPOINT_DB=./amaris_checkpoints.db

# ── Behavior ──────────────────────────────────────────────
MAX_REVISIONS=2
MAX_REACT_ITERATIONS=4
# hard stop on the supervisor loop, regardless of what the llm decides
MAX_SUPERVISOR_STEPS=15
RESEARCH_QUALITY_THRESHOLD=0.60
QUALITY_APPROVE_THRESHOLD=0.72
# how long an agent may wait out a rate limit before giving up (groq's tpm window is ~60s)
LLM_RETRY_BUDGET_SECONDS=75
# ragas makes one judge call per metric per context, so it needs its own ceiling
RAGAS_TIMEOUT_SECONDS=120

# ── Emailing a report (optional) ──────────────────────────
# resend.com free tier, ~3000/month. Leave RESEND_API_KEY empty and the email
# control is not rendered at all.
RESEND_API_KEY=
# without a verified domain resend only lets you send FROM this shared address,
# and usually only TO the address the account was registered with
EMAIL_FROM=AMARIS <onboarding@resend.dev>
# JSON list. Empty means any recipient, which cloud mode refuses — a public demo
# that mails anywhere is an open relay. Example: ["gmail.com","yourcompany.com"]
EMAIL_ALLOWED_DOMAINS=[]
EMAIL_MAX_PER_SESSION=5

# ── Model IDs (update if providers rename them) ───────────
GROQ_MODEL_REASONING=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b
GEMINI_MODEL_FALLBACK=gemini-3.6-flash
ANTHROPIC_MODEL=claude-sonnet-5
