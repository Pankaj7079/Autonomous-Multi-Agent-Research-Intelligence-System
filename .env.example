
# ── Deployment ────────────────────────────────────────────
# "local" = docker redis + qdrant + fastapi

DEPLOYMENT_MODE=local

PRIMARY_PROVIDER=groq

EVAL_PROVIDER=gemini

# ── LLMs (all free, no card) ──────────────────────────────
GROQ_API_KEY=gsk_your_key_here

GEMINI_API_KEY=AIza_your_key_here

GLM_API_KEY=your_key_here

ANTHROPIC_API_KEY=

# ── Search ────────────────────────────────────────────────

TAVILY_API_KEY=

# ── Observability ─────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=./logs

LOG_JSON_ENABLED=true
# --- tracing (ADR-046): optional, langsmith is the only backend ---
# needs no other setup — langchain reads these and traces every model call
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=amaris

# ── Local services (docker-compose provides these) ────────
# the streamlit frontend calls this in local mode
API_BASE_URL=http://localhost:8000

REDIS_URL=redis://localhost:6379
QDRANT_HOST=localhost
QDRANT_PORT=6333
# for cloud mode: cloud.qdrant.io free tier 1GB
QDRANT_URL=
QDRANT_API_KEY=

# ── LangGraph ─────────────────────────────────────────────
SQLITE_CHECKPOINT_DB=./checkpoints.db

# ── Behavior ──────────────────────────────────────────────
MAX_REVISIONS=2
MAX_REACT_ITERATIONS=4
MAX_SUPERVISOR_STEPS=15
RESEARCH_QUALITY_THRESHOLD=0.60
QUALITY_APPROVE_THRESHOLD=0.72
LLM_RETRY_BUDGET_SECONDS=75
# ragas makes one judge call per metric per context, so it needs its own ceiling
RAGAS_TIMEOUT_SECONDS=120

# ── Emailing a report  ──────────────────────────
# resend.com free tier, ~3000/month. 
RESEND_API_KEY=
EMAIL_FROM=AMARIS <onboarding@resend.dev>

EMAIL_ALLOWED_DOMAINS=[]
EMAIL_MAX_PER_SESSION=5

# ── Model IDs (update if providers rename them) ───────────
GROQ_MODEL_REASONING=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b
GEMINI_MODEL_FALLBACK=gemini-3.6-flash
ANTHROPIC_MODEL=claude-sonnet-5

# --- MCP client (ADR-042) -------------------------------------------------
MCP_CLIENT_ENABLED=true
MCP_FILESYSTEM_ROOT=
# a classic PAT enables the hosted GitHub MCP endpoint — no OAuth app needed
GITHUB_TOKEN=
